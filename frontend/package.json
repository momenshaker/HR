{
  "name": "hr-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "generate:api": "openapi --input ../docs/api/openapi.yaml --output src/app/core/api-client --client axios --useUnionTypes --exportServices --indent 2",
    "generate:api:recruitment": "openapi --input ../docs/api/recruitment.openapi.yaml --output src/app/core/api-client/recruitment --client axios --useUnionTypes --exportServices --indent 2",
    "generate:api:core": "openapi --input ../docs/api/core-services.yaml --output src/app/core/api-client/core --client axios --useUnionTypes --exportServices --indent 2"
  },
  "dependencies": {
    "@angular/animations": "^17.3.5",
    "@angular/cdk": "^17.3.5",
    "@angular/common": "^17.3.5",
    "@angular/compiler": "^17.3.5",
    "@angular/core": "^17.3.5",
    "@angular/forms": "^17.3.5",
    "@angular/material": "^17.3.5",
    "@angular/platform-browser": "^17.3.5",
    "@angular/platform-browser-dynamic": "^17.3.5",
    "@angular/router": "^17.3.5",
    "@ngx-translate/core": "^16.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.14.4",
    "bootstrap": "^5.3.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.5",
    "@angular/cli": "^17.3.5",
    "@angular/compiler-cli": "^17.3.5",
    "@types/jasmine": "^5.1.0",
    "@types/node": "^20.11.19",
    "jasmine-core": "^5.1.1",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "openapi-typescript-codegen": "^0.24.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.3.3"
  }
}
