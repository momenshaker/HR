{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HrPlatform": {
    "Data": {
      "RepositoryProvider": "EntityFrameworkCore",
      "Database": {
        "Provider": "SqlServer",
        "ConnectionStringName": "HrDatabase",
        "EnableDetailedErrors": false,
        "EnableSensitiveDataLogging": false
      }
    },
    "Features": {
      "EmployeeManagement": true,
      "OrganizationStructure": true,
      "AttendanceAndTimeTracking": true,
      "LeaveManagement": true,
      "PayrollManagement": true,
      "PerformanceManagement": true,
      "RecruitmentAndAts": true,
      "TrainingAndDevelopment": true,
      "InternalCommunication": true,
      "HrAnalytics": true,
      "DelegatedAuthority": true,
      "SelfService": true
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HrDatabase": "Server=localhost;Database=HrPlatform;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
